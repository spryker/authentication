parameters:
    level: 8
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
#        API Platform Generated resource classes are intentionally excluded from generation
#        (see config/GlueStorefront/packages/spryker_api_platform.php).
#        Authentication API Platform implementation will be migrated in a dedicated module.
        - '#invalid type Generated\\Api\\Storefront\\RefreshTokensStorefrontResource\.#'
        - '#invalid return type Generated\\Api\\Storefront\\RefreshTokensStorefrontResource\.#'
        - '#unknown class Generated\\Api\\Storefront\\RefreshTokensStorefrontResource\.#'
        - '#Instantiated class Generated\\Api\\Storefront\\RefreshTokensStorefrontResource not found\.#'
        - '#invalid type Generated\\Api\\Storefront\\TokensStorefrontResource\.#'
        - '#invalid return type Generated\\Api\\Storefront\\TokensStorefrontResource\.#'
        - '#unknown class Generated\\Api\\Storefront\\TokensStorefrontResource\.#'
        - '#Instantiated class Generated\\Api\\Storefront\\TokensStorefrontResource not found\.#'
